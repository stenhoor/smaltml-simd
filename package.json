{
  "name": "@smaltworks/smaltml-simd",
  "version": "0.14.0",
  "description": "WebAssembly SIMD kernels for smaltml, written by TypeScript.",
  "keywords": [
    "machine-learning",
    "simd",
    "webassembly",
    "smaltml",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stenhoor/smaltml-simd.git"
  },
  "homepage": "https://github.com/stenhoor/smaltml-simd#readme",
  "scripts": {
    "typecheck": "node node_modules/typescript7/bin/tsc -p tsconfig.json --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "check": "npm run typecheck && npm test",
    "build": "node scripts/build.mjs",
    "bench": "tsc -p tsconfig.bench.json && node .bench/bench/fits.js",
    "prepare": "npm run build",
    "test:browser": "node test/browser/docs.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kernels": {
      "types": "./dist/kernels.d.ts",
      "default": "./dist/smaltml-simd-kernels.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@smaltworks/smaltml": ">=0.1.0"
  },
  "devDependencies": {
    "@smaltworks/smaltml": "github:stenhoor/smaltml#5d94024e8183c508fae596fd3809dff783a3573f",
    "@types/node": "^22.20.5",
    "playwright": "1.64.1",
    "typescript": "~6.0.3",
    "typescript7": "npm:typescript@~7.0.2",
    "vitepress": "1.6.4"
  },
  "dependencies": {
    "smaltkit": "github:stenhoor/smaltkit#b11282580619cac9f2d68cb69203fdb770e9a350"
  }
}
